# ===================================================
# ENTERPRISE SECURITY FIREWALL (.htaccess)
# ===================================================

# 1. Disable Directory Indexing & Set Upload Size Limit (10MB)
Options -Indexes
LimitRequestBody 10485760

# 2. Block Direct Access to Database & Sensitive Directories + SEO 301 Redirects
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^database(/.*)?$ - [F,L,NC]
    RewriteRule ^node_modules(/.*)?$ - [F,L,NC]
    RewriteRule ^plan_seo(/.*)?$ - [F,L,NC]

    # Legacy WordPress & RSS Feed Permanent 301 Redirects (Google Search Console Cleanup)
    RewriteRule ^wp-(.*)$ / [R=301,L,NC]
    RewriteRule ^feed/?(.*)$ / [R=301,L,NC]
    RewriteRule ^comments/feed/?(.*)$ / [R=301,L,NC]
    RewriteRule ^(.*)/feed/?$ / [R=301,L,NC]
</IfModule>

# 3. Block Sensitive File Extensions from Being Downloaded
<FilesMatch "\.(json|bat|env|md|lock|log|sh|config|bak|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Block Hidden Files (e.g. .git, .env)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 5. HTTP Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. High-Performance Browser Caching (Lighthouse 100 Cache Lifetime)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 7. Gzip Compression (Speed & Bandwidth Savings)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|webp|svg|woff2?|ttf|css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>
