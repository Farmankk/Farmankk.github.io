PassengerAppRoot "/home2/carrentc/domains/car4rent.com.pk/public_html"
PassengerBaseURI "/"
PassengerNodejs "/home2/carrentc/nodevenv/domains/car4rent.com.pk/public_html/19/bin/node"
PassengerAppType node
PassengerStartupFile server.js
